#!/usr/bin/env bash
set -euo pipefail

# ---------------------------
# Config
# ---------------------------
ENDPOINT="${ENDPOINT:-us-east-1.linodeobjects.com}"

# ---------------------------
# Color helpers
# ---------------------------
if [[ -t 1 && -z "${NO_COLOR:-}" ]]; then
  RESET=$'\e[0m'
  BOLD=$'\e[1m'
  DIM=$'\e[2m'
  RED=$'\e[31m'
  GREEN=$'\e[32m'
  YELLOW=$'\e[33m'
  CYAN=$'\e[36m'
  GRAY=$'\e[90m'
else
  RESET='' BOLD='' DIM='' RED='' GREEN='' YELLOW='' CYAN='' GRAY=''
fi

pct_color() {
  local p="${1:-}"
  [[ -z "$p" ]] && { printf '%s' "$GRAY"; return; }
  awk -v p="$p" '
    BEGIN {
      if (p >= 90) print "RED";
      else if (p >= 70) print "YELLOW";
      else print "GREEN";
    }
  ' | while read -r c; do
    case "$c" in
      RED)    printf '%s' "$RED" ;;
      YELLOW) printf '%s' "$YELLOW" ;;
      GREEN)  printf '%s' "$GREEN" ;;
      *)      printf '%s' "$GRAY" ;;
    esac
  done
}

print_row() {
  # label, value, pct_numeric(optional)
  local label="$1"
  local value="$2"
  local pct="${3:-}"
  local c; c="$(pct_color "$pct")"
  printf "%-26s %s%s%s\n" "$label" "$c" "$value" "$RESET"
}

print_plain() {
  # label, value, color(optional)
  local label="$1"
  local value="$2"
  local color="${3:-$CYAN}"
  printf "%-26s %s%s%s\n" "$label" "$color" "$value" "$RESET"
}

fail_row() {
  local label="$1"
  local msg="$2"
  printf "%-26s %s%s%s\n" "$label" "$RED" "$msg" "$RESET"
}

# ---------------------------
# Parsers
# ---------------------------
parse_transfer() {
  # outputs: used \t quota \t pct_num \t pct_disp
  linode-cli account transfer --text 2>/dev/null | awk '
    BEGIN{ in_main=0; found=0 }
    $1=="quota" && $2=="used" && $3=="billable" { in_main=1; next }
    in_main && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ {
      quota=$1+0; used=$2+0
      if (quota==0) { printf "%d\t%d\t\tN/A\n", used, quota; found=1; exit 0 }
      p=(used/quota)*100
      printf "%d\t%d\t%.6f\t%.2f%%\n", used, quota, p, p
      found=1; exit 0
    }
    END{ if(!found) exit 1 }
  '
}

parse_obj() {
  # $1 = bytes|buckets|objects
  local type="$1"
  local quota_id="obj-${type}-${ENDPOINT}"

  linode-cli object-storage quota-usage-view "$quota_id" --text 2>/dev/null | awk -v mode="$type" '
    function human(b,   units,i,val) {
      split("B KiB MiB GiB TiB PiB EiB", units, " ")
      val = b + 0
      for (i=1; i<length(units) && val >= 1024; i++) val /= 1024
      return sprintf("%.2f %s", val, units[i])
    }
    function commify(n,   s,len,r) {
      s = sprintf("%.0f", n)
      len = length(s)
      if (len <= 3) return s
      r = ""
      while (len > 3) { r = "," substr(s, len-2, 3) r; len -= 3 }
      return substr(s, 1, len) r
    }

    BEGIN{ quota=""; used="" }
    $1=="quota_limit" && $2=="usage" { next }
    $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ { quota=$1+0; used=$2+0 }

    END{
      if (quota=="" || used=="") exit 1
      if (quota==0) {
        if (mode=="bytes") printf "%s\t%s\t\tN/A\n", human(used), human(quota)
        else               printf "%s\t%s\t\tN/A\n", commify(used), commify(quota)
        exit 0
      }
      p=(used/quota)*100
      pct_disp = (p>0 && p<0.01) ? "<0.01%" : sprintf("%.2f%%", p)

      if (mode=="bytes") printf "%s\t%s\t%.6f\t%s\n", human(used), human(quota), p, pct_disp
      else               printf "%s\t%s\t%.6f\t%s\n", commify(used), commify(quota), p, pct_disp
    }
  '
}

parse_linodes_running_list() {
  # stdout:
  #   first line: running_count \t total_count
  #   then: id \t label   (for each running linode)
  linode-cli linodes ls --text 2>/dev/null | awk '
    NR==1 { next }  # header
    {
      total++
      status=$6
      if (status=="running") {
        n++
        ids[n]=$1
        labels[n]=$2
      }
    }
    END {
      printf "%d\t%d\n", n+0, total+0
      for (i=1; i<=n; i++) printf "%s\t%s\n", ids[i], labels[i]
    }
  '
}

parse_linode_transfer() {
  # $1 = linode_id
  # linode transfer-view returns used in BYTES and quota in (GiB-ish) units like 2434
  local id="$1"
  linode-cli linodes transfer-view "$id" --text 2>/dev/null | awk '
    function human(b,   units,i,val) {
      split("B KiB MiB GiB TiB PiB EiB", units, " ")
      val = b + 0
      for (i=1; i<length(units) && val >= 1024; i++) val /= 1024
      return sprintf("%.2f %s", val, units[i])
    }

    BEGIN{ found=0 }
    $1=="billable" && $2=="quota" && $3=="used" { next } # header
    $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ {
      billable=$1+0
      quota_gib=$2+0
      used_bytes=$3+0

      quota_bytes = quota_gib * 1024 * 1024 * 1024

      if (quota_bytes == 0) {
        printf "%s\t%s\t\tN/A\n", human(used_bytes), human(quota_bytes)
        found=1
        exit 0
      }

      p = (used_bytes / quota_bytes) * 100
      pct_disp = (p>0 && p<0.01) ? "<0.01%" : sprintf("%.2f%%", p)

      printf "%s\t%s\t%.6f\t%s\n", human(used_bytes), human(quota_bytes), p, pct_disp
      found=1
      exit 0
    }
    END{ if(!found) exit 1 }
  '
}

# ---------------------------
# Main
# ---------------------------
if ! command -v linode-cli >/dev/null 2>&1; then
  echo "${RED}linode-cli not found in PATH${RESET}" >&2
  exit 127
fi

now="$(date '+%Y-%m-%d %H:%M:%S')"
days_quota_left="$((($(date -d "$(date +%Y-%m-01) +1 month -0 day" +%s) - $(date +%s)) / 86400))"

echo "${BOLD}${CYAN}Linode Usage Summary${RESET} ${DIM}(${now})${RESET}"
echo "${BOLD}${CYAN}Days left until quota reset:${RESET} ${DIM}${days_quota_left}${RESET}"
echo

# Account transfer
if tsv="$(parse_transfer)"; then
  IFS=$'\t' read -r used quota pct_num pct_disp <<<"$tsv"
  print_row "Global account transfer" "${used} GiB/${quota} GiB (${pct_disp})" "${pct_num:-}"
else
  fail_row "Global account transfer" "could not parse (check auth/permissions)"
fi

echo

# Object storage (3 quotas)
echo "${DIM}Object Storage endpoint:${RESET} ${BOLD}${ENDPOINT}${RESET}"
for typ in bytes buckets objects; do
  label="Obj storage ${typ}"
  if tsv="$(parse_obj "$typ")"; then
    IFS=$'\t' read -r used quota pct_num pct_disp <<<"$tsv"
    print_row "$label" "${used}/${quota} (${pct_disp})" "${pct_num:-}"
  else
    fail_row "$label" "could not parse (quota id or endpoint?)"
  fi
done

echo

# Linodes running + per-linode transfer usage
if mapfile -t lines < <(parse_linodes_running_list); then
  if [[ ${#lines[@]} -ge 1 ]]; then
    IFS=$'\t' read -r running total <<<"${lines[0]}"
    print_plain "Linodes running" "${running}/${total}"

    if [[ "$running" -gt 0 ]]; then
      for ((i=1; i<${#lines[@]}; i++)); do
        IFS=$'\t' read -r lid llabel <<<"${lines[i]}"
        if tsv="$(parse_linode_transfer "$lid")"; then
          IFS=$'\t' read -r used quota pct_num pct_disp <<<"$tsv"
          print_row "Linode ${llabel}" "${used}/${quota} (${pct_disp})" "${pct_num:-}"
        else
          fail_row "Linode ${llabel}" "could not read transfer-view"
        fi
      done
    fi
  else
    fail_row "Linodes running" "could not parse linodes list"
  fi
else
  fail_row "Linodes running" "could not read linodes list"
fi

